    "graph",
    "blame",
    "regression"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "git-replay": "bin/git-replay.js",
    "git-replay-cli": "bin/git-replay.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haileamlakwalelige/git-replay.git"
  },
  "homepage": "https://haileamlakwalelige.github.io/git-replay/",
  "bugs": {
